{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "webapp/main.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Current Python Module",
      "type": "debugpy",
      "request": "launch",
      "module": "${relativeFileDirname}.${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}